# Backend
SENTINEL_DATABASE_URL=sqlite:///./sentinel.db
SENTINEL_MAX_UPLOAD_BYTES=10485760
SENTINEL_NVD_ENABLED=true
SENTINEL_NVD_API_KEY=
SENTINEL_NVD_CACHE_TTL_SECONDS=900
SENTINEL_NVD_MIN_INTERVAL_SECONDS=6

# Browser origins allowed to call the API. Either a JSON array or a plain
# comma-separated list works. Credentials are disabled automatically if "*".
SENTINEL_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# AI provider (optional). Auto tries OpenRouter free models, then OpenAI, then
# a local Ollama, then a deterministic local fallback. Set SENTINEL_LLM_PROVIDER
# to auto, openrouter, openai, ollama (forced first) or none (no LLM calls).
SENTINEL_LLM_PROVIDER=auto
SENTINEL_OPENROUTER_API_KEY="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"
SENTINEL_OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
SENTINEL_OPENAI_API_KEY="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"
SENTINEL_OPENAI_MODEL=gpt-4o-mini
SENTINEL_OLLAMA_BASE_URL=http://localhost:11434
SENTINEL_OLLAMA_MODEL=llama3.1

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
API_INTERNAL_URL=http://localhost:8000
